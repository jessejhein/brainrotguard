BRG_BOT_TOKEN=your-telegram-bot-token-here
BRG_ADMIN_CHAT_ID=your-telegram-chat-id-here
BRG_ADMIN_USER_IDS=
BRG_PIN=
BRG_BASE_URL=http://your-server-ip:8080
# BRG_LOG_LEVEL=info  # debug, info, warning, error (default: info)

# Optional triage bridge (describe-only; see docs/triage.md). Leave disabled unless
# a Hermes webhook route is configured to receive requests and answer verdicts.
# BRG_TRIAGE_ENABLED=false
# BRG_TRIAGE_URL=http://hermes-host:8644/p/brgtriage/webhooks/brg-request
# BRG_TRIAGE_SECRET=shared-secret-for-outbound-posts
# BRG_TRIAGE_CALLBACK_SECRET=shared-secret-for-the-verdict-callback
# BRG_TRIAGE_DEADLINE_S=60
# BRG_TRIAGE_REPLY_ENABLED=true
